<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="center" android:contentDescription="@string/widget_description" />
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="@string/setup_widget" android:textColor="#FFFFFFFF"
        android:background="#DD11151D" android:textSize="12sp" android:padding="8dp" />
</FrameLayout>
